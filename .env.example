# Environment variables for the Remotie funnel. Names and placeholders only: this file is committed to Git.
# Put the real values in Vercel > Project > Settings > Environment Variables, then redeploy.
# For local `vercel dev`, copy this file to .env.local (Git ignores it) and fill it in there.

# Email (see EMAIL_DELIVERABILITY_SETUP.md). Empty optional values fall back to the defaults in api/submit-lead.js.
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=
ADMIN_EMAIL=
REPLY_TO_EMAIL=
ALLOWED_ORIGIN=
ENABLE_FORMSPREE_BACKUP=

# Meta Pixel + Conversions API (see META_PIXEL_CAPI_SETUP.md)
META_DATASET_ID=1757698228867001
META_ACCESS_TOKEN=your_meta_capi_access_token_here
META_TEST_EVENT_CODE=
META_API_VERSION=v26.0
